/*
 * 百分百命中 / LD14 独立测试桥 V0.1
 * 功能：LD14 UART2 -> ESP32 -> USB串口 + WiFi UDP
 * 不接入M100运动控制，不产生任何运动命令。
 *
 * 接线（经典 ESP32 Dev Module）：
 * LD14 Tx  -> ESP32 GPIO16 (RX2)
 * LD14 GND -> ESP32 GND
 * LD14 P5V -> 独立稳定5V（不要接ESP32 3V3）
 * LD14 PWM -> GND或悬空，使用内部6Hz控速
 * 所有电源必须共地。
 */
#include <WiFi.h>
#include <WiFiUdp.h>

// ========== 用户配置 ==========
const char* WIFI_SSID = "YOUR_WIFI_NAME_HERE";
const char* WIFI_PASS = "YOUR_WIFI_PASSWORD_HERE";
#define ENABLE_WIFI 1
#define ENABLE_USB_FORWARD 1
#define ENABLE_UDP_FORWARD 1

// ========== LD14 UART ==========
HardwareSerial LidarSerial(2);
const int LD14_RX_PIN = 16;
const int LD14_TX_PIN = 17; // 不连接LD14，仅用于完成UART2映射
const uint32_t LD14_BAUD = 115200;
const size_t LD14_FRAME_LEN = 47;
uint8_t frame[LD14_FRAME_LEN];
size_t framePos = 0;

// ========== PC链路 ==========
const uint32_t USB_BAUD = 921600;
const uint16_t UDP_CMD_PORT = 4210;
const uint16_t UDP_DATA_PORT = 4211;
WiFiUDP udp;
IPAddress pcIP;
bool hasPC = false;
uint32_t goodFrames = 0, badFrames = 0, droppedPackets = 0;

static const uint8_t CRC_TABLE[256] = {0x00, 0x4D, 0x9A, 0xD7, 0x79, 0x34, 0xE3, 0xAE, 0xF2, 0xBF, 0x68, 0x25, 0x8B, 0xC6, 0x11, 0x5C, 0xA9, 0xE4, 0x33, 0x7E, 0xD0, 0x9D, 0x4A, 0x07, 0x5B, 0x16, 0xC1, 0x8C, 0x22, 0x6F, 0xB8, 0xF5, 0x1F, 0x52, 0x85, 0xC8, 0x66, 0x2B, 0xFC, 0xB1, 0xED, 0xA0, 0x77, 0x3A, 0x94, 0xD9, 0x0E, 0x43, 0xB6, 0xFB, 0x2C, 0x61, 0xCF, 0x82, 0x55, 0x18, 0x44, 0x09, 0xDE, 0x93, 0x3D, 0x70, 0xA7, 0xEA, 0x3E, 0x73, 0xA4, 0xE9, 0x47, 0x0A, 0xDD, 0x90, 0xCC, 0x81, 0x56, 0x1B, 0xB5, 0xF8, 0x2F, 0x62, 0x97, 0xDA, 0x0D, 0x40, 0xEE, 0xA3, 0x74, 0x39, 0x65, 0x28, 0xFF, 0xB2, 0x1C, 0x51, 0x86, 0xCB, 0x21, 0x6C, 0xBB, 0xF6, 0x58, 0x15, 0xC2, 0x8F, 0xD3, 0x9E, 0x49, 0x04, 0xAA, 0xE7, 0x30, 0x7D, 0x88, 0xC5, 0x12, 0x5F, 0xF1, 0xBC, 0x6B, 0x26, 0x7A, 0x37, 0xE0, 0xAD, 0x03, 0x4E, 0x99, 0xD4, 0x7C, 0x31, 0xE6, 0xAB, 0x05, 0x48, 0x9F, 0xD2, 0x8E, 0xC3, 0x14, 0x59, 0xF7, 0xBA, 0x6D, 0x20, 0xD5, 0x98, 0x4F, 0x02, 0xAC, 0xE1, 0x36, 0x7B, 0x27, 0x6A, 0xBD, 0xF0, 0x5E, 0x13, 0xC4, 0x89, 0x63, 0x2E, 0xF9, 0xB4, 0x1A, 0x57, 0x80, 0xCD, 0x91, 0xDC, 0x0B, 0x46, 0xE8, 0xA5, 0x72, 0x3F, 0xCA, 0x87, 0x50, 0x1D, 0xB3, 0xFE, 0x29, 0x64, 0x38, 0x75, 0xA2, 0xEF, 0x41, 0x0C, 0xDB, 0x96, 0x42, 0x0F, 0xD8, 0x95, 0x3B, 0x76, 0xA1, 0xEC, 0xB0, 0xFD, 0x2A, 0x67, 0xC9, 0x84, 0x53, 0x1E, 0xEB, 0xA6, 0x71, 0x3C, 0x92, 0xDF, 0x08, 0x45, 0x19, 0x54, 0x83, 0xCE, 0x60, 0x2D, 0xFA, 0xB7, 0x5D, 0x10, 0xC7, 0x8A, 0x24, 0x69, 0xBE, 0xF3, 0xAF, 0xE2, 0x35, 0x78, 0xD6, 0x9B, 0x4C, 0x01, 0xF4, 0xB9, 0x6E, 0x23, 0x8D, 0xC0, 0x17, 0x5A, 0x06, 0x4B, 0x9C, 0xD1, 0x7F, 0x32, 0xE5, 0xA8};

uint8_t calCRC8(const uint8_t* p, size_t len) {
  uint8_t crc = 0;
  for (size_t i = 0; i < len; ++i) crc = CRC_TABLE[(crc ^ p[i]) & 0xFF];
  return crc;
}

void forwardFrame(const uint8_t* p) {
#if ENABLE_USB_FORWARD
  Serial.write(p, LD14_FRAME_LEN); // PC端直接按0x54 0x2C同步
#endif
#if ENABLE_WIFI && ENABLE_UDP_FORWARD
  if (hasPC && WiFi.status() == WL_CONNECTED) {
    if (udp.beginPacket(pcIP, UDP_DATA_PORT)) {
      udp.write(p, LD14_FRAME_LEN);
      if (!udp.endPacket()) droppedPackets++;
    } else droppedPackets++;
  }
#endif
}

void feedLidarByte(uint8_t b) {
  if (framePos == 0) {
    if (b == 0x54) frame[framePos++] = b;
    return;
  }
  if (framePos == 1) {
    if (b == 0x2C) frame[framePos++] = b;
    else { framePos = 0; if (b == 0x54) frame[framePos++] = b; }
    return;
  }
  frame[framePos++] = b;
  if (framePos == LD14_FRAME_LEN) {
    if (calCRC8(frame, LD14_FRAME_LEN - 1) == frame[LD14_FRAME_LEN - 1]) {
      goodFrames++;
      forwardFrame(frame);
    } else badFrames++;
    framePos = 0;
  }
}

void handleUdpCommand() {
#if ENABLE_WIFI
  int n = udp.parsePacket();
  if (n <= 0) return;
  char cmd[32] = {0};
  int got = udp.read((uint8_t*)cmd, sizeof(cmd) - 1);
  if (got <= 0) return;
  pcIP = udp.remoteIP();
  hasPC = true;
  if (strncmp(cmd, "HELLO", 5) == 0) {
    char msg[96];
    snprintf(msg, sizeof(msg), "LD14ESP,ip=%s,good=%lu,bad=%lu",
             WiFi.localIP().toString().c_str(),
             (unsigned long)goodFrames, (unsigned long)badFrames);
    udp.beginPacket(pcIP, UDP_DATA_PORT);
    udp.write((const uint8_t*)msg, strlen(msg));
    udp.endPacket();
  }
#endif
}

void setup() {
  Serial.begin(USB_BAUD);
  LidarSerial.setRxBufferSize(4096);
  LidarSerial.begin(LD14_BAUD, SERIAL_8N1, LD14_RX_PIN, LD14_TX_PIN);
#if ENABLE_WIFI
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  uint32_t t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < 15000) delay(100);
  if (WiFi.status() == WL_CONNECTED) udp.begin(UDP_CMD_PORT);
#endif
}

void loop() {
  while (LidarSerial.available() > 0) feedLidarByte((uint8_t)LidarSerial.read());
  handleUdpCommand();
}
